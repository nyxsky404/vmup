{
  "name": "@nyxsky404/vmup",
  "version": "0.3.0",
  "description": "Batch files to a remote host over SSH for coding agents",
  "type": "module",
  "main": "./dist/cli.js",
  "exports": {
    ".": "./dist/cli.js"
  },
  "bin": {
    "vmup": "dist/cli.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nyxsky404/vmup.git"
  },
  "homepage": "https://github.com/nyxsky404/vmup#readme",
  "bugs": {
    "url": "https://github.com/nyxsky404/vmup/issues"
  },
  "files": [
    "dist",
    "scripts/install.sh",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "!dist/**/*.test.js",
    "!dist/**/*.test.d.ts"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/cli.js",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build && npm test",
    "test": "node --test dist/*.test.js"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "ssh",
    "scp",
    "files",
    "screenshots",
    "agents",
    "cli",
    "upload"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "dependencies": {
    "chokidar": "^4.0.3",
    "commander": "^13.1.0",
    "smol-toml": "^1.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2"
  }
}
